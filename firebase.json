{
  "hosting": {
    "public": "out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/favicon.ico", "destination": "/logo.jpg" },
      { "source": "/api/**", "destination": "https://gadget-repairs-glasgow.onrender.com/api/**" },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**/*.html", "headers": [{ "key": "Cache-Control", "value": "max-age=0, must-revalidate" }] },
      { "source": "/sitemap.xml", "headers": [{ "key": "Content-Type", "value": "application/xml; charset=utf-8" }, { "key": "Cache-Control", "value": "max-age=3600" }] },
      { "source": "/robots.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "max-age=3600" }] },
      { "source": "/rss.xml", "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }, { "key": "Cache-Control", "value": "max-age=3600" }] },
      { "source": "/llms.txt", "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }, { "key": "Cache-Control", "value": "max-age=3600" }] },
      { "source": "/manifest.json", "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }, { "key": "Cache-Control", "value": "max-age=3600" }] },
      { "source": "**/*.@(js|mjs|css)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
      { "source": "**/*.@(svg|png|jpg|jpeg|gif|webp|avif|ico|woff|woff2)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
    ],
    "cleanUrls": true,
    "trailingSlash": false
  }
}
